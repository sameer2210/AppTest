{
  "name": "stepwars_backend",
  "version": "1.0.0",
  "main": "dist/src/server.js",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:validators": "vitest run validator --coverage",
    "test:coverage:zod": "vitest run --coverage",
    "build": "tsc && tsc-alias",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "lint:imports": "node scripts/check-feature-imports.mjs",
    "prestart": "npm run build",
    "start": "node dist/src/server.js",
    "dev": "tsx watch src/server.ts",
    "dev:dist": "npm run build && nodemon dist/src/server.js",
    "worker": "tsx src/worker.ts",
    "seed:staff": "tsx src/scripts/seed-demo-staff.ts"
  },
  "type": "module",
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1092.0",
    "@google/genai": "^2.15.0",
    "body-parser": "^2.2.0",
    "bullmq": "^6.3.6",
    "cheerio": "^1.2.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "firebase-admin": "^13.5.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "moment-timezone": "^0.6.0",
    "mongoose": "^8.23.0",
    "morgan": "^1.10.1",
    "multer": "^2.2.0",
    "node-cron": "^4.2.1",
    "nodemailer": "^7.0.6",
    "posthog-node": "^5.36.6",
    "razorpay": "^2.9.6",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.10.1",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^8.0.1",
    "@types/supertest": "^7.2.1",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@vitest/coverage-v8": "^4.1.11",
    "mongodb-memory-server": "^11.2.0",
    "nodemon": "^3.1.10",
    "supertest": "^7.2.2",
    "tsc-alias": "^1.9.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.1.9"
  }
}
