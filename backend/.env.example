# Server
PORT=5000
NODE_ENV=development
# Structured [STEP_TRACE] step-tracking debug logs (uid/email/phone + sync decisions).
# Set to "false" to silence once the step-tracking corruption bug is diagnosed/fixed.
STEP_TRACE_LOGGING=true

# MongoDB (required unless USE_IN_MEMORY_MONGO=true)
MONGO_URI=mongodb://localhost:27017/stron
# USE_IN_MEMORY_MONGO=true

# Firebase Admin (required) — base64-encoded service account JSON
FIREBASE_SERVICE_ACCOUNT=
# FIREBASE_DB_URL=

# JWT (global access + refresh) — required
JWT_SECRET=change-me
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d

# OTP — core settings (OTP_HASH_PEPPER required)
OTP_EXPIRY_MINUTES=5
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_MAX_RESENDS=3
OTP_MAX_VERIFY_ATTEMPTS=5
OTP_LENGTH=6
OTP_HASH_PEPPER=change-me-long-random-secret
OTP_MAX_SENDS_PER_PHONE_PER_HOUR=3
OTP_MAX_SENDS_PER_PHONE_PER_MINUTE=3
OTP_MAX_VERIFY_FAILURES_PER_PHONE_PER_HOUR=5

# APITxT OTP API — APITXT_AUTH_KEY required; TEMPLATE_ID optional (https://apitxt.com/developer/otp-api)
APITXT_AUTH_KEY=
APITXT_TEMPLATE_ID=
APITXT_CHANNEL=sms
APITXT_COUNTRY=91

# STRON Managed Events
# Platform commission on the ticket price (percent). Participant also pays the gateway fee.
SM_PLATFORM_COMMISSION_PCT=10
# Gateway fee added on top of the ticket price and shown separately at checkout (percent).
SM_GATEWAY_FEE_PCT=2
# Maximum event duration in days (publish validation).
SM_MAX_DURATION_DAYS=90
# Active STRON-managed listings allowed per (non-team) organizer.
SM_ACTIVE_LISTING_LIMIT=5
# King of the Hill group sizing.
SM_KOTH_MIN_GROUP=2
SM_KOTH_MAX_GROUP=5
# How often (minutes) to promote published→live and live→completed (1 = every minute).
SM_LIFECYCLE_INTERVAL_MINUTES=1
# How often (minutes) to reconcile King of the Hill king-time (1 = every minute).
SM_KOTH_RECONCILE_INTERVAL_MINUTES=1
# Face Off instant-knockout step lead threshold.
SM_FACEOFF_KO_STEP_LEAD=3000
# Daily step band used to simulate bot participants.
SM_BOT_DAILY_STEPS_MIN=4000
SM_BOT_DAILY_STEPS_MAX=12000
# Settlement payout window in business days (3-5 per spec).
SM_SETTLEMENT_MIN_BUSINESS_DAYS=3
SM_SETTLEMENT_MAX_BUSINESS_DAYS=5
# Default event day-start clock (IST). Currently informational; events anchor to 00:00.
SM_DEFAULT_DAY_START_HHMM=00:00


# Optional global registration coupon (code + flat INR discount) for STRON-managed tickets.
# Managed-event registration coupon (code + percent off ticket price).
MARATHON_COUPON_CODE=StronMarathon202526
MARATHON_COUPON_DISCOUNT_PERCENT=50

# STRON Opinions — GNews headlines + Gemini question generation (fallback pool if unset/fails)
GNEWS_API_KEY=
# Working models: gemini-flash-latest, gemini-2.5-flash-lite
GEMINI_API_KEY=

# PostHog (optional — backend product events; never log the key in commits)
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com

# Razorpay — required (tickets, gym memberships, payouts)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# STRON PRO (RevenueCat monthly IAP) — required; never commit real keys
# Secret REST API key (sk_...) used to verify subscribers server-side
REVENUECAT_SECRET_KEY=
# Webhook Authorization Bearer token (AUTH_TOKEN is a legacy alias — either is enough)
REVENUECAT_WEBHOOK_AUTH_KEY=
REVENUECAT_WEBHOOK_AUTH_TOKEN=
# Entitlement identifier from the RevenueCat dashboard (also accepts stron_pro)
REVENUECAT_ENTITLEMENT_ID=Stron Pro Premium Plan
# SDK offering identifiers (must match RevenueCat dashboard Identifiers, not REST ids)
# Paywall B / trial: offering `default` (REST ofrng5de840d2e8) — Play stron_pro:monthly, iOS com.t21.stron.pro.montly
# Paywall A / no trial: offering `stron_pro_no_trial` (REST ofrngaddee2e514) — Play stron_pro:monthly-notrial, iOS com.t21.stron.pro.montly.notrial
# Deprecated OFFERING_ID + OFFERING_REST_ID are the no-trial pair. PRODUCT_STORE_ID / IOS_PRODUCT_ID are trial SKUs.
REVENUECAT_STRON_PRO_OFFERING_NO_TRIAL_ID=stron_pro_no_trial
REVENUECAT_STRON_PRO_OFFERING_TRIAL_ID=default
REVENUECAT_STRON_PRO_OFFERING_ID=stron_pro_no_trial
REVENUECAT_STRON_PRO_OFFERING_TRIAL_REST_ID=ofrng5de840d2e8
REVENUECAT_STRON_PRO_OFFERING_NO_TRIAL_REST_ID=ofrngaddee2e514
REVENUECAT_STRON_PRO_OFFERING_REST_ID=ofrngaddee2e514
REVENUECAT_STRON_PRO_PRODUCT_ID=stron_pro
REVENUECAT_STRON_PRO_PRODUCT_STORE_ID=stron_pro:monthly
REVENUECAT_STRON_PRO_IOS_PRODUCT_ID=com.t21.stron.pro.montly
REVENUECAT_STRON_PRO_NO_TRIAL_PRODUCT_STORE_ID=stron_pro:monthly-notrial
REVENUECAT_STRON_PRO_NO_TRIAL_IOS_PRODUCT_ID=com.t21.stron.pro.montly.notrial
# Dev-only: allow sync without RC when NODE_ENV is not production
ALLOW_DEV_PRO_SYNC_BYPASS=false

# Cloudflare R2 — required (primary image storage for app uploads)
R2_BUCKET=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Public bucket/custom domain (optional). If empty, backend proxies via /api/upload/public/:key
R2_PUBLIC_BASE_URL=
# Required — used in share links / App Links
PUBLIC_API_BASE_URL=https://apidev.stron.in
# Public web origin used to build brand-page share URLs (no trailing slash).
PUBLIC_WEB_BASE_URL=https://stron.in

# WhatsApp Cloud API (single STRON platform WABA).
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_TEST_DISPLAY_PHONE=

# HTTP Basic password for Swagger UI at /api-docs (username is `stron`).
SWAGGER_PASSWORD=

# Redis for BullMQ. Optional for API boot — if Redis is down, WhatsApp jobs use in-memory queues.
REDIS_URL=redis://127.0.0.1:6379
