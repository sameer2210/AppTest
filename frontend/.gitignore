/ios
/android
.kotlin/

# Metro
.metro-health-check*

# Build / bundler
*.tsbuildinfo
build/
*.apk
*.aab
*.ipa

# Environment & secrets
.env
.env*.local
!.env.example

# Debug logs
npm-debug.*
yarn-debug.*
yarn-error.*
pnpm-debug.log*
*.log

# OS
.DS_Store
Thumbs.db
*.pem

