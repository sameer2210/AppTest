*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision
keystore.properties
google-services.json.local
GoogleService-Info.plist.local

# IDE
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.swp
*.swo
*~

# Testing / coverage
coverage/
.nyc_output/

# EAS
.eas/

# Temporary
tmp/
temp/
.cache/

